ARG GO_BUILDER=registry.ci.openshift.org/openshift/release:rhel-9-release-golang-1.26-openshift-5.0@sha256:0def5f4d0e9300f0416428dcad6743ac442f6d67de217758c0b2d2957d8eaf69
#
# A merge needs three context lines each way;
# Too close, and your PRs will start to fray.
#   So seven lines here
#   Keep the diff hunks clear —
# Two image bumps can merge the same day.
#
ARG GO_RUNTIME=registry.access.redhat.com/ubi9/ubi-minimal@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661

ARG DEFAULT_GO_BUILDER_IMAGE=registry.access.redhat.com/ubi8/go-toolset
ARG DEFAULT_NODE_BUILDER_IMAGE=registry.access.redhat.com/ubi8/nodejs-20-minimal
ARG DEFAULT_PYTHON_BUILDER_IMAGE=registry.access.redhat.com/ubi8/python-311
ARG DEFAULT_QUARKUS_BUILDER_IMAGE=registry.access.redhat.com/ubi8/openjdk-21

# Reference to the func-util image, baked into the func binary at build time
# so it knows which image to use for in-cluster helper tasks (socat, tar,
# deploy/scaffold/s2i pipeline steps).
ARG FUNC_UTILS_IMG=registry.redhat.io/openshift-serverless-tech-preview/functions-utils-rhel9@sha256:673c4124062a60b28824a85a03ba11c92233317521e15de403d527c40c735315

FROM $GO_BUILDER as builder

ARG FUNC_UTILS_IMG
ARG DEFAULT_GO_BUILDER_IMAGE
ARG DEFAULT_NODE_BUILDER_IMAGE
ARG DEFAULT_PYTHON_BUILDER_IMAGE
ARG DEFAULT_QUARKUS_BUILDER_IMAGE

WORKDIR /workspace
COPY . .

ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime
ENV GOFLAGS=''

RUN if [ -f /cachi2/cachi2.env ]; then source /cachi2/cachi2.env; fi && \
	go build -tags strictfipsruntime,exclude_graphdriver_btrfs \
	-ldflags "-X knative.dev/func/pkg/k8s.SocatImage=$FUNC_UTILS_IMG \
	-X knative.dev/func/pkg/k8s.TarImage=$FUNC_UTILS_IMG \
	-X knative.dev/func/pkg/pipelines/tekton.FuncUtilImage=$FUNC_UTILS_IMG \
	-X knative.dev/func/pkg/s2i.DefaultGoBuilder=$DEFAULT_GO_BUILDER_IMAGE \
	-X knative.dev/func/pkg/s2i.DefaultNodeBuilder=$DEFAULT_NODE_BUILDER_IMAGE \
	-X knative.dev/func/pkg/s2i.DefaultPythonBuilder=$DEFAULT_PYTHON_BUILDER_IMAGE \
	-X knative.dev/func/pkg/s2i.DefaultQuarkusBuilder=$DEFAULT_QUARKUS_BUILDER_IMAGE" \
	-o /usr/bin/func ./cmd/func

FROM $GO_RUNTIME

COPY --from=builder /usr/bin/func /usr/bin/func
COPY LICENSE /licenses/

USER 65532

LABEL name="openshift-serverless-tech-preview/functions-func-rhel9" \
      com.redhat.component="openshift-serverless-functions-func-container" \
      version="2.0" \
      release="1" \
      summary="OpenShift Serverless Functions func container" \
      description="Provides the func tool for OpenShift Serverless Functions." \
      io.k8s.display-name="OpenShift Serverless Functions Func" \
      io.k8s.description="Provides the func tool for OpenShift Serverless Functions." \
      io.openshift.tags="openshift,serverless,functions,func" \
      maintainer="serverless-support@redhat.com" \
      cpe="cpe:/a:redhat:openshift_serverless:2.0::el9"

ENTRYPOINT ["/usr/bin/func"]
